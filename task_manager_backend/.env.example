# Database (provided by task_manager_database container)
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# JWT configuration
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=10080

# CORS (comma separated, or '*' for all)
CORS_ALLOW_ORIGINS=*
